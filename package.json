{
  "name": "file-preview-stream",
  "version": "0.0.8",
  "description": "Framework-agnostic file preview core: detect type from a Blob/stream and produce renderable output (blob URL, text, HTML skeleton).",
  "keywords": [
    "file-preview",
    "preview",
    "blob",
    "stream",
    "attachment",
    "mime",
    "docx",
    "xlsx",
    "markdown",
    "pdf"
  ],
  "license": "MIT",
  "author": "iding2959",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iding2959/file-preview-stream.git"
  },
  "bugs": {
    "url": "https://github.com/iding2959/file-preview-stream/issues"
  },
  "homepage": "https://github.com/iding2959/file-preview-stream#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/markdown": {
      "import": {
        "types": "./dist/adapters/markdown.d.ts",
        "default": "./dist/adapters/markdown.js"
      },
      "require": {
        "types": "./dist/adapters/markdown.d.cts",
        "default": "./dist/adapters/markdown.cjs"
      }
    },
    "./adapters/excel": {
      "import": {
        "types": "./dist/adapters/excel.d.ts",
        "default": "./dist/adapters/excel.js"
      },
      "require": {
        "types": "./dist/adapters/excel.d.cts",
        "default": "./dist/adapters/excel.cjs"
      }
    },
    "./adapters/docx": {
      "import": {
        "types": "./dist/adapters/docx.d.ts",
        "default": "./dist/adapters/docx.js"
      },
      "require": {
        "types": "./dist/adapters/docx.d.cts",
        "default": "./dist/adapters/docx.cjs"
      }
    },
    "./adapters/html": {
      "import": {
        "types": "./dist/adapters/html.d.ts",
        "default": "./dist/adapters/html.js"
      },
      "require": {
        "types": "./dist/adapters/html.d.cts",
        "default": "./dist/adapters/html.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.10.1",
    "dompurify": "3.4.13",
    "eslint": "9.39.5",
    "jsdom": "^25.0.1",
    "marked": "18.0.9",
    "tsup": "9.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "docx-preview": ">=0.4.0",
    "dompurify": ">=3.0.0",
    "marked": ">=12.0.0",
    "xlsx": ">=0.18.5"
  },
  "peerDependenciesMeta": {
    "docx-preview": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "postal-mime": "^4.2.1",
    "unrar-js": "^0.2.3"
  },
  "optionalDependencies": {
    "node-unrar-js": "^2.0.2"
  }
}
